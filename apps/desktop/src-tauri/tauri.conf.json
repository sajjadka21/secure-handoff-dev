{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipBridge",
  "version": "0.1.0",
  "identifier": "org.clipbridge.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "ClipBridge", "width": 1180, "height": 780, "minWidth": 860, "minHeight": 620 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": "all", "category": "Utility", "shortDescription": "Private device-to-device handoff" }
}
